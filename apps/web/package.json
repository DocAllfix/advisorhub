{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "esbuild src/lib/email/worker-entry.ts --bundle --platform=node --target=node22 --format=cjs --outfile=worker.js",
    "start": "node .next/standalone/apps/web/server.js",
    "posta": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/lib/email/worker-entry.ts",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/lib/migra.ts",
    "db:seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/lib/seed.ts",
    "db:seed-demo": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/lib/seed-demo.ts",
    "db:migrate:kit": "drizzle-kit migrate",
    "build:migratore": "esbuild src/lib/migra.ts --bundle --platform=node --target=node22 --format=cjs --outfile=migra.js",
    "e2e:prepara": "next build && node scripts/copia-static.mjs && pnpm build:worker",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:titolare": "esbuild src/lib/crea-titolare.ts --bundle --platform=node --target=node22 --format=cjs --outfile=crea-titolare.js",
    "build:bundle": "pnpm build:migratore && pnpm build:worker && pnpm build:titolare"
  },
  "dependencies": {
    "@finbeacon/engine": "workspace:*",
    "@formkit/auto-animate": "^0.10.0",
    "@hookform/resolvers": "^5.4.0",
    "@number-flow/react": "^0.6.2",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.67.0",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "driver.js": "^1.8.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.25.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.10",
    "papaparse": "^5.5.4",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.82.0",
    "recharts": "^3.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "shadcn": "^4.13.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
