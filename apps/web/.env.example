# Copia questo file in .env e compila i valori. Il .env non va mai versionato.

# --- Database (Supabase, region EU) ---
# Runtime: transaction pooler, porta 6543
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migration: session pooler, porta 5432
# (l'host diretto db.<ref>.supabase.co è solo IPv6: da reti IPv4 usa il pooler)
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Nella password i caratteri speciali vanno codificati: % -> %25, @ -> %40

# --- Autenticazione ---
# Genera con: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Telemetria (facoltativa) ---
# Senza DSN la telemetria resta inattiva e l'app funziona identica
NEXT_PUBLIC_SENTRY_DSN=
