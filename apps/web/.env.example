# Copia questo file in .env e compila i valori. Il .env non va mai versionato.

# --- Database (Supabase, region EU) ---
# Runtime: transaction pooler, porta 6543
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migration: session pooler, porta 5432
# (l'host diretto db.<ref>.supabase.co è solo IPv6: da reti IPv4 usa il pooler)
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Nella password i caratteri speciali vanno codificati: % -> %25, @ -> %40

# --- Autenticazione ---
# Genera con: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Accessi ---
# In produzione la registrazione pubblica e' chiusa: gli studi si creano a mano.
# Metti "true" solo se vuoi riaprirla (in sviluppo e' gia' aperta).
NEXT_PUBLIC_REGISTRAZIONE_APERTA=

# --- Telemetria (facoltativa) ---
# Senza DSN la telemetria resta inattiva e l'app funziona identica
NEXT_PUBLIC_SENTRY_DSN=

# --- Posta transazionale ---
# Senza SMTP_HOST le email restano in coda (mail_outbox) e non partono: l'app
# funziona, ma il recupero password non arriva a destinazione.
# In sviluppo: avvia Mailpit con
#   docker compose -f deploy/docker-compose.dev.yml up -d
# e leggi i messaggi su http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@advisorhub.local

# --- Accessi (lato server) ---
# In produzione la registrazione pubblica e' chiusa: questo e' il cancello vero.
# La NEXT_PUBLIC_ omonima controlla solo cosa mostra l'interfaccia.
# Il provisioning crea il titolare eseguendo il seed con REGISTRAZIONE_APERTA=true
# per quella singola esecuzione.
REGISTRAZIONE_APERTA=

# --- Release ---
# Impostata dalla CI al GIT_SHA: compare in /api/health e nella telemetria.
GIT_SHA=
