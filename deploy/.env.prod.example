# Copia in deploy/.env.prod sul server del cliente e compila. MAI committare.
# Lo genera provision-cliente.sh con segreti casuali: questo file documenta i campi.
# Permessi attesi: chmod 600.

# --- Identita' dell'istanza ---
SLUG=acme
DOMINIO=acme.advisorhub.it
ACME_EMAIL=tecnico@advisorhub.it

# --- Immagine (costruita dalla CI, taggata col commit) ---
IMMAGINE=ghcr.io/<organizzazione>/advisorhub:<git-sha>
GIT_SHA=<git-sha>

# --- Database (interno al server, mai esposto) ---
POSTGRES_USER=advisorhub
POSTGRES_PASSWORD=   # openssl rand -hex 24
POSTGRES_DB=advisorhub

# --- Autenticazione ---
# openssl rand -hex 32. Perderlo invalida tutte le sessioni: finisce nel backup.
BETTER_AUTH_SECRET=

# --- Posta ---
# La casella arriva COL DOMINIO: registrando il dominio-brand su Hostinger si ha
# gia' SMTP, e SPF/DKIM/DMARC si configurano nello stesso pannello della zona DNS.
# Nessun fornitore transazionale in piu'. Vedi RUNBOOK.md §0.1.
#
# ATTENZIONE: se SMTP_HOST resta vuoto le mail NON partono e non c'e' alcun
# errore — restano in coda in mail_outbox. Il recupero password smette di
# funzionare in silenzio, e se ne accorge il cliente il giorno che serve.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=ops@advisorhub.it
SMTP_PASSWORD=
# Il mittente e' il dominio-brand, non quello del cliente.
SMTP_FROM=no-reply@advisorhub.it

# --- Collaudo senza DNS pubblico ---
# Direttiva INTERA, non solo "internal" (GUASTI G-15). Vuota in produzione.
CADDY_TLS=
